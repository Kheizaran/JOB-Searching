# Copy to .env — .env is gitignored.

# Required for anything beyond --dry-run
ANTHROPIC_API_KEY=

# Optional model overrides
JOBSEARCH_MODEL_FAST=claude-haiku-4-5-20251001
JOBSEARCH_MODEL_MAIN=claude-sonnet-5

# Put a real contact address in the scraper User-Agent (good manners, fewer blocks)
JOBSEARCH_CONTACT=you@example.com
